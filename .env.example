# Server
HOST=0.0.0.0
PORT=1337
URL=http://localhost:1337

# Secrets — generate secure random strings for each (e.g. `openssl rand -base64 32`)
APP_KEYS=changeMe1,changeMe2
ADMIN_JWT_SECRET=changeMe
API_TOKEN_SALT=changeMe
ENCRYPTION_KEY=changeMe
TRANSFER_TOKEN_SALT=changeMe

# Database — set DATABASE_CLIENT to "postgres" or "mysql" for production
# When deploying on Railway, add the PostgreSQL plugin and set DATABASE_URL
DATABASE_CLIENT=sqlite
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=resillix
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
