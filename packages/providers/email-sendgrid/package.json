{
  "name": "@resillix/provider-email-sendgrid",
  "version": "5.42.0",
  "description": "Sendgrid provider for strapi email",
  "keywords": [
    "email",
    "resillix",
    "sendgrid"
  ],
  "homepage": "https://github.com/Dhananjay-latpate/RCMS",
  "bugs": {
