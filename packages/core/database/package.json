{
  "name": "@resillix/database",
  "version": "5.42.0",
  "description": "Resillix CMS's database layer",
  "homepage": "https://github.com/Dhananjay-latpate/RCMS",
  "bugs": {
    "url": "https://github.com/Dhananjay-latpate/RCMS/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/strapi/strapi.git",
    "directory": "packages/core/database"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Resillix CMS",
    "url": "https://github.com/Dhananjay-latpate/RCMS"
  },
  "maintainers": [
    {
      "name": "Resillix CMS",
      "url": "https://github.com/Dhananjay-latpate/RCMS"
    }
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "run -T npm-run-all clean --parallel build:code build:types",
    "build:code": "run -T  rollup -c",
    "build:types": "run -T tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "run -T rimraf ./dist",
    "lint": "run -T tsc --noEmit && run -T eslint .",
    "test:unit": "run -T jest",
    "test:unit:watch": "run -T jest --watch",
    "watch": "run -T rollup -c -w"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "2.2.2",
    "@resillix/utils": "5.42.0",
    "ajv": "8.18.0",
    "date-fns": "2.30.0",
    "debug": "4.3.4",
    "fs-extra": "11.2.0",
    "knex": "3.0.1",
    "lodash": "4.18.1",
    "semver": "7.5.4",
    "umzug": "3.8.1"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "eslint-config-custom": "5.42.0",
    "tsconfig": "5.42.0"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  }
}
